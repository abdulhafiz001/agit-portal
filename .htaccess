# Disable directory listing for security
Options -Indexes

RewriteEngine On
# LOCAL: RewriteBase /agit-portal/  |  PRODUCTION: RewriteBase /portal/
RewriteBase /agit-portal/
# SetEnv APP_URL only in production vhost; app auto-detects from request otherwise


# Don't rewrite existing files/directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything to index.php
RewriteRule ^(.*)$ index.php [QSA,L]
